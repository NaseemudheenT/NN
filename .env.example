# Nero Noren — environment
# Copy to .env.local and fill in. Never commit .env.local.
#
# Every integration below is optional: the site runs without any of them and
# says plainly on the page what is missing. Nothing is ever invented to fill
# a gap — no placeholder prices, stock or AI answers.

# --- Catalogue: pieces, prices, stock, photography, size charts -------------
# Storefront API. Product metafields read from the "nn" namespace:
#   nn.colour, nn.swatch, nn.fabric, nn.fit_notes, nn.model_glb,
#   nn.size_chart (JSON), nn.care (JSON array)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Admin API — server-side only, for writing orders back to Shopify
SHOPIFY_ADMIN_TOKEN=

# --- Payments ---------------------------------------------------------------
# Only the key id ever reaches the browser. The secret signs and verifies
# every payment on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- The stylist ------------------------------------------------------------
# Called only from /api/stylist, never from the browser.
ANTHROPIC_API_KEY=

# --- Owner console ----------------------------------------------------------
# Supabase sends the one-time sign-in link; OWNER_EMAILS decides who may use it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAILS=

# --- Site -------------------------------------------------------------------
# Used for canonical URLs, the sitemap and the owner sign-in redirect.
NEXT_PUBLIC_SITE_URL=
