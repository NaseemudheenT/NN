# ─── Shopify (headless Storefront API) ──────────────────────────────
# Products, prices, stock and cart. Without these the site serves the
# Collection 001 seed catalogue and shows a notice naming what is missing.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Admin API token — only needed to create orders after a verified payment.
SHOPIFY_ADMIN_TOKEN=

# ─── Razorpay (payments — UPI, cards, netbanking) ───────────────────
# Test mode keys only until launch. KEY_ID is the only one sent to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Claude API (AI stylist, trial-room fit notes, owner console) ────
# Server-side only. Never expose to the browser.
ANTHROPIC_API_KEY=

# ─── Supabase (owner auth, showroom settings, analytics) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Owner console access ───────────────────────────────────────────
# Comma-separated list of emails allowed into /owner.
OWNER_EMAILS=

# ─── Public site URL (Open Graph, sitemap, Razorpay callbacks) ──────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
